{
  "openapi": "3.0.3",
  "info": {
    "title": "Abdo Store API",
    "description": "Abdo Store API offers a range of social media marketing services, providing users with access to tools for enhancing their online presence. It supports services like account management, balance loading, and order placement, all aimed at improving social media engagement. The API is designed for ease of use with robust customer support available 24/7.",
    "version": "1.0.0",
    "contact": {
      "url": "https://abdoastore.store/"
    }
  },
  "servers": [
    {
      "url": "https://abdoastore.store",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/services": {
      "get": {
        "summary": "Get available services",
        "description": "Retrieves a list of available social media marketing services offered by Abdo Store",
        "operationId": "getServices",
        "tags": [
          "Services"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of services",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "description": "Service ID"
                          },
                          "name": {
                            "type": "string",
                            "description": "Service name"
                          },
                          "category": {
                            "type": "string",
                            "description": "Service category"
                          },
                          "price": {
                            "type": "number",
                            "format": "float",
                            "description": "Service price"
                          },
                          "min": {
                            "type": "integer",
                            "description": "Minimum order quantity"
                          },
                          "max": {
                            "type": "integer",
                            "description": "Maximum order quantity"
                          },
                          "description": {
                            "type": "string",
                            "description": "Service description"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/balance": {
      "get": {
        "summary": "Get account balance",
        "description": "Retrieves the current account balance for the authenticated user",
        "operationId": "getBalance",
        "tags": [
          "Account"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with balance information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "balance": {
                      "type": "number",
                      "format": "float",
                      "description": "Current account balance"
                    },
                    "currency": {
                      "type": "string",
                      "description": "Currency code",
                      "example": "USD"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/order": {
      "post": {
        "summary": "Place a new order",
        "description": "Creates a new order for a social media marketing service",
        "operationId": "createOrder",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "service_id",
                  "link",
                  "quantity"
                ],
                "properties": {
                  "service_id": {
                    "type": "integer",
                    "description": "ID of the service to order"
                  },
                  "link": {
                    "type": "string",
                    "description": "Link to the social media post or profile"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Quantity of the service to order"
                  },
                  "comments": {
                    "type": "string",
                    "description": "Additional comments or instructions (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order successfully placed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "order_id": {
                      "type": "integer",
                      "description": "Unique order identifier"
                    },
                    "charge": {
                      "type": "number",
                      "format": "float",
                      "description": "Amount charged for the order"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{order_id}": {
      "get": {
        "summary": "Get order status",
        "description": "Retrieves the status and details of a specific order",
        "operationId": "getOrderStatus",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "The order ID to retrieve",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with order details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "order": {
                      "type": "object",
                      "properties": {
                        "order_id": {
                          "type": "integer",
                          "description": "Order ID"
                        },
                        "service_id": {
                          "type": "integer",
                          "description": "Service ID"
                        },
                        "link": {
                          "type": "string",
                          "description": "Target link"
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "Order quantity"
                        },
                        "start_count": {
                          "type": "integer",
                          "description": "Start count"
                        },
                        "remains": {
                          "type": "integer",
                          "description": "Remaining quantity"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "Pending",
                            "In progress",
                            "Completed",
                            "Canceled",
                            "Partial"
                          ],
                          "description": "Order status"
                        },
                        "charge": {
                          "type": "number",
                          "format": "float",
                          "description": "Order charge"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication. Contact support to obtain your API key."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "description": "Error message describing what went wrong"
          },
          "code": {
            "type": "string",
            "description": "Error code for programmatic handling"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Services",
      "description": "Operations related to available social media marketing services"
    },
    {
      "name": "Account",
      "description": "Operations related to account management and balance"
    },
    {
      "name": "Orders",
      "description": "Operations related to creating and managing orders"
    }
  ]
}
