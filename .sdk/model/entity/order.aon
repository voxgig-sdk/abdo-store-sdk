                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /api/order/{order_id}"
            json: "{\"operationId\":\"getOrderStatus\",\"parameters\":[{\"description\":\"The order ID to retrieve\",\"in\":\"path\",\"name\":\"order_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"order\":{\"properties\":{\"charge\":{\"description\":\"Order charge\",\"format\":\"float\",\"type\":\"number\"},\"link\":{\"description\":\"Target link\",\"type\":\"string\"},\"order_id\":{\"description\":\"Order ID\",\"type\":\"integer\"},\"quantity\":{\"description\":\"Order quantity\",\"type\":\"integer\"},\"remains\":{\"description\":\"Remaining quantity\",\"type\":\"integer\"},\"service_id\":{\"description\":\"Service ID\",\"type\":\"integer\"},\"start_count\":{\"description\":\"Start count\",\"type\":\"integer\"},\"status\":{\"description\":\"Order status\",\"enum\":[\"Pending\",\"In progress\",\"Completed\",\"Canceled\",\"Partial\"],\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"example\":\"success\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with order details\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code for programmatic handling\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"status\":{\"example\":\"error\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - Invalid or missing API key\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code for programmatic handling\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"status\":{\"example\":\"error\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Order not found\"}},\"security\":[{\"ApiKeyAuth\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key for authentication. Contact support to obtain your API key.\",\"in\":\"header\",\"name\":\"X-API-Key\",\"type\":\"apiKey\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
