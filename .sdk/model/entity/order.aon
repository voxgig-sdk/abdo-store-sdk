# Entity: order

main: kit: entity: order: {

  alias: field: {}

  fields: [
    {
      name: "charge"
      req: false
      short: "Order charge"
      type: "`$NUMBER`"
    }
    {
      name: "comments"
      req: false
      short: "Additional comments or instructions (optional)"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "link"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Target link"
      type: "`$STRING`"
    }
    {
      name: "order_id"
      req: false
      short: "Order ID"
      type: "`$INTEGER`"
    }
    {
      name: "quantity"
      op: {
        create: {
          req: true
          type: "`$INTEGER`"
        }
      }
      req: false
      short: "Order quantity"
      type: "`$INTEGER`"
    }
    {
      name: "remains"
      req: false
      short: "Remaining quantity"
      type: "`$INTEGER`"
    }
    {
      name: "service_id"
      op: {
        create: {
          req: true
          type: "`$INTEGER`"
        }
      }
      req: false
      short: "Service ID"
      type: "`$INTEGER`"
    }
    {
      name: "start_count"
      req: false
      short: "Start count"
      type: "`$INTEGER`"
    }
    {
      name: "status"
      req: false
      short: "Order status"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "order"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/order"
          parts: [
            "api"
            "order"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "order_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/order/{order_id}"
          parts: [
            "api"
            "order"
            "{id}"
          ]
          rename: {
            param: {
              order_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.order`"
          }
        }
      ]
    }
  }



}
