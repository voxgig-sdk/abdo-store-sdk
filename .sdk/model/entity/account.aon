# Entity: account

main: kit: entity: account: {

  alias: field: {}

  fields: [
    {
      format: "float"
      name: "balance"
      req: false
      short: "Current account balance"
      type: "`$NUMBER`"
    }
    {
      name: "currency"
      req: false
      short: "Currency code"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "account"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/balance"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "balance"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
