# Entity: account

main: kit: entity: account: {

  alias: field: {}

  fields: {
    balance: {
      fo: "float"
      h: "Balance"
      n: "balance"
      r: false
      sh: "Current account balance"
      t: "`$NUMBER`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: false
      sh: "Currency code"
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      t: "`$STRING`"
    }
  }

  name: "account"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/balance"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/balance"
          s: [
            {
              lit: "api"
            }
            {
              lit: "balance"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
